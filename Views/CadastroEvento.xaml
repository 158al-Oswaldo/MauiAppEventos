<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppEventos.Views.CadastroEvento"
             Title="Cadastro de Eventos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Novo Evento" FontSize="26" FontAttributes="Bold" />

            <Label Text="Nome do evento" />
            <Entry x:Name="txt_nome" Placeholder="Ex.: Congresso de Tecnologia" />

            <Label Text="Data de início" />
            <DatePicker x:Name="dtpck_inicio" Format="dd/MM/yyyy" />

            <Label Text="Data de término" />
            <DatePicker x:Name="dtpck_termino" Format="dd/MM/yyyy" />

            <Label Text="Número de participantes" />
            <Entry x:Name="txt_participantes" Keyboard="Numeric" Placeholder="Ex.: 100" />

            <Label Text="Local do evento" />
            <Entry x:Name="txt_local" Placeholder="Ex.: Centro de Convenções" />

            <Label Text="Custo por participante (R$)" />
            <Entry x:Name="txt_custo" Keyboard="Numeric" Placeholder="Ex.: 49,90" />

            <Button Text="Cadastrar evento"
                    Margin="0,15,0,0"
                    Clicked="Button_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
