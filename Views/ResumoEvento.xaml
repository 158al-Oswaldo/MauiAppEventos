<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppEventos.Views.ResumoEvento"
             Title="Resumo do Evento">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Resumo do Evento" FontSize="26" FontAttributes="Bold" />

            <Label Text="{Binding Nome, StringFormat='Evento: {0}'}" FontSize="18" />
            <Label Text="{Binding Local, StringFormat='Local: {0}'}" FontSize="18" />
            <Label Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}" FontSize="18" />
            <Label Text="{Binding DataTermino, StringFormat='Término: {0:dd/MM/yyyy}'}" FontSize="18" />
            <Label Text="{Binding NumeroParticipantes, StringFormat='Participantes: {0}'}" FontSize="18" />
            <Label Text="{Binding CustoPorParticipante, StringFormat='Custo por participante: {0:C}'}" FontSize="18" />

            <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

            <!-- TimeSpan exibido: diferença entre as datas (DataTermino - DataInicio) -->
            <Label Text="{Binding Diferenca, StringFormat='Diferença (TimeSpan): {0}'}" FontSize="18" />
            <Label Text="{Binding Diferenca.Days, StringFormat='Dias entre as datas: {0}'}" FontSize="18" />
            <Label Text="{Binding DuracaoDias, StringFormat='Duração do evento: {0} dia(s)'}"
                   FontSize="18" FontAttributes="Bold" />

            <Label Text="{Binding CustoTotal, StringFormat='Custo total: {0:C}'}"
                   FontSize="22" FontAttributes="Bold" TextColor="DarkGreen" Margin="0,10,0,0" />

            <Button Text="Novo cadastro" Margin="0,20,0,0" Clicked="Button_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
